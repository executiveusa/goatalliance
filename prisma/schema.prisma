// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  CONTRACTOR
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum ContractorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LandingPageStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  DISQUALIFIED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  PAID_SEARCH
  ORGANIC
  SOCIAL
  PARTNER
  OTHER
}

enum ABTestStatus {
  PLANNED
  RUNNING
  PAUSED
  COMPLETED
}

enum VoiceAgentStatus {
  ACTIVE
  INACTIVE
  TRAINING
  ERROR
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(CLIENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth
  accounts      Account[]
  sessions      Session[]
  
  // Profile
  contractor    Contractor?
  orders        Order[]
  subscriptions Subscription[]
  reviews       Review[]
  blogPosts     BlogPost[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Contractor {
  id          String            @id @default(cuid())
  userId      String            @unique
  businessName String?
  description String?
  website     String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String           @default("US")
  status      ContractorStatus @default(PENDING)
  isPremium   Boolean          @default(false)
  rating      Float?
  reviewCount Int              @default(0)
  
  // Metadata (stored as JSON strings for SQLite compatibility)
  skills      String    @default("[]")
  experience  Int? // years of experience
  portfolio   String?   // JSON stored as string
  certifications String @default("[]")
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews     Review[]
  categories  ContractorCategory[]
  
  @@map("contractors")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  contractors ContractorCategory[]
  
  @@map("categories")
}

model ContractorCategory {
  contractorId String
  categoryId   String
  
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([contractorId, categoryId])
  @@map("contractor_categories")
}

model Review {
  id           String   @id @default(cuid())
  contractorId String
  clientId     String
  rating       Int      // 1-5
  title        String?
  comment      String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  client       User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@map("reviews")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  stripeSubscriptionId String?         @unique
  stripePriceId     String
  stripeCustomerId  String?
  status            SubscriptionStatus
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("subscriptions")
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  stripePaymentIntentId String? @unique
  amount           Int      // in cents
  currency         String   @default("usd")
  status           String   // succeeded, pending, failed
  description      String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("orders")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  authorId    String?
  
  // SEO
  metaTitle   String?
  metaDescription String?
  
  // Timestamps
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  author      User?    @relation(fields: [authorId], references: [id])
  
  @@map("blog_posts")
}

model Niche {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)

  services     Service[]
  landingPages LandingPage[]
  leads        Lead[]
  templates    SiteTemplate[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("niches")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  nicheId     String

  niche       Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model LandingPage {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  nicheId     String
  status      LandingPageStatus @default(DRAFT)
  goal        String?
  locale      String            @default("en-US")

  niche       Niche             @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  variants    LandingVariant[]
  abTests     ABTest[]
  leads       Lead[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("landing_pages")
}

model LandingVariant {
  id          String   @id @default(cuid())
  landingPageId String
  name        String
  slug        String
  isControl   Boolean  @default(false)
  trafficPercentage Int @default(50)
  headline    String?
  subheadline String?
  content     Json?

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  leads       Lead[]
  abTestLinks ABTestVariant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([landingPageId, slug])
  @@map("landing_variants")
}

model ABTest {
  id          String       @id @default(cuid())
  landingPageId String
  name        String
  status      ABTestStatus @default(PLANNED)
  goal        String?
  metric      String?
  startsAt    DateTime?
  endsAt      DateTime?

  landingPage LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  variants    ABTestVariant[]
  leads       Lead[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ab_tests")
}

model ABTestVariant {
  id              String   @id @default(cuid())
  abTestId        String
  landingVariantId String
  trafficPercentage Int    @default(50)
  isControl       Boolean  @default(false)

  abTest          ABTest         @relation(fields: [abTestId], references: [id], onDelete: Cascade)
  landingVariant  LandingVariant @relation(fields: [landingVariantId], references: [id], onDelete: Cascade)

  @@unique([abTestId, landingVariantId])
  @@map("ab_test_variants")
}

model Lead {
  id              String     @id @default(cuid())
  nicheId         String
  landingPageId   String?
  landingVariantId String?
  abTestId        String?
  source          LeadSource @default(WEBSITE)
  status          LeadStatus @default(NEW)
  score           Int        @default(0)

  name            String?
  email           String?
  phone           String?
  serviceType     String?
  message         String?
  zipCode         String?
  city            String?
  state           String?
  utm             Json?
  metadata        Json?

  niche           Niche          @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  landingPage     LandingPage?   @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  landingVariant  LandingVariant? @relation(fields: [landingVariantId], references: [id], onDelete: SetNull)
  abTest          ABTest?        @relation(fields: [abTestId], references: [id], onDelete: SetNull)
  voiceCalls      VoiceCall[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("leads")
}

model VoiceAgent {
  id          String           @id @default(cuid())
  name        String
  provider    String
  status      VoiceAgentStatus @default(INACTIVE)
  phoneNumber String?
  voice       String?
  config      Json?

  calls       VoiceCall[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("voice_agents")
}

model VoiceCall {
  id           String        @id @default(cuid())
  voiceAgentId String
  leadId       String?
  direction    CallDirection @default(INBOUND)
  status       CallStatus    @default(QUEUED)
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  transcript   String?
  summary      String?
  metadata     Json?

  voiceAgent   VoiceAgent   @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("voice_calls")
}

model SiteTemplate {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  nicheId     String?
  status      TemplateStatus @default(ACTIVE)
  description String?
  sections    Json?

  niche       Niche?         @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("site_templates")
}

// ============================================================
// GOAT ALLIANCE MVP - Vibe Cockpit CRM Models
// ============================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContactStatus {
  NEW
  ACTIVE
  INACTIVE
  VIP
}

enum ContactSource {
  FACEBOOK
  GOOGLE
  REFERRAL
  WEBSITE
  WHATSAPP
  PHONE
  OTHER
}

model Contact {
  id          String        @id @default(cuid())
  businessId  String
  name        String
  phone       String?
  email       String?
  address     String?
  city        String        @default("Seattle")
  state       String        @default("WA")
  status      ContactStatus @default(NEW)
  source      ContactSource @default(WEBSITE)
  tags        String        @default("[]") // JSON array stored as string for SQLite
  notes       String?
  totalRevenue Float        @default(0)
  jobCount    Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("contacts")
}

model Appointment {
  id          String            @id @default(cuid())
  businessId  String
  contactId   String
  title       String
  service     String
  scheduledAt DateTime
  duration    Int               @default(60) // minutes
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  price       Float?
  reminderSent Boolean         @default(false)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  businessId  String
  eventType   String   // lead_received, appointment_booked, job_completed, revenue_recorded
  source      String?  // facebook, google, referral, etc.
  value       Float    @default(0)
  metadata    String   @default("{}") // JSON stored as string for SQLite

  createdAt   DateTime @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("analytics_events")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  ownerName   String
  phone       String?
  email       String?
  website     String?
  city        String   @default("Seattle")
  state       String   @default("WA")
  niche       String   @default("general") // painter, plumber, roofer, etc.
  avatarConfig String  @default("{}") // JSON stored as string for SQLite
  plan        String   @default("starter") // starter, pro, agency
  isActive    Boolean  @default(true)

  // Magic link auth
  magicTokens MagicToken[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts     Contact[]
  appointments Appointment[]
  analytics    AnalyticsEvent[]

  @@map("businesses")
}

model MagicToken {
  id         String   @id @default(cuid())
  businessId String
  token      String   @unique
  phone      String?
  email      String?
  expiresAt  DateTime
  usedAt     DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@map("magic_tokens")
}
