    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.3.1",
    "@stripe/stripe-js": "^10.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/nodemailer": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.3.0",
    "gray-matter": "^4.0.3",
