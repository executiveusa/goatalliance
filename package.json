    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.1.4",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
